rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function existingData() {
      return resource.data;
    }

    function incomingData() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Whether a user may read a private game's data. Players always can;
    // others can only while the game is open and not reserved for someone else.
    // config.reservedFor is absent when nobody is reserved, hence get().
    function canReadPrivate(game) {
      return isSignedIn() && (
        game.config.players.hasAny([request.auth.uid]) ||
        (game.config.isOpen == true &&
          game.config.get('reservedFor', null) in [null, request.auth.uid])
      );
    }

    function privateGame(gameID) {
      return get(
        /databases/$(database)/documents/gamesPrivate/$(gameID)
      ).data;
    }

    // Games are written only by Cloud Functions (Admin SDK bypasses rules).
    // Clients may delete their own game while it is still open.
    function canDeleteOpenGame() {
      return isUser(existingData().createdBy) &&
        existingData().config.isOpen == true;
    }

    // One name per account: a registered user claims the name their ID
    // token carries (their display name), lower-cased
    match /names/{name} {
      allow get: if isSignedIn();
      allow create: if isUser(incomingData().uid) &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        name == request.auth.token.get('name', '').lower() &&
        incomingData().keys().hasOnly(['uid']);
      allow update, delete: if false;
    }

    match /gamesPublic/{game} {
      allow get, list: if isSignedIn();
      allow create, update: if false;
      allow delete: if canDeleteOpenGame();

      match /branches/{branch} {
        allow get: if branch == 'root' && isSignedIn();
        allow list, write: if false;
      }
    }

    match /gamesPrivate/{game} {
      allow get: if canReadPrivate(existingData());
      // A user lists the games they are seated in, or are invited to
      allow list: if isSignedIn() && (
        request.auth.uid in existingData().config.players ||
        existingData().config.reservedFor == request.auth.uid
      );
      allow create, update: if false;
      allow delete: if canDeleteOpenGame();

      match /branches/{branch} {
        allow get: if branch == 'root' && canReadPrivate(privateGame(game));
        allow list, write: if false;
      }
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isUser(uid);
    }

    // Not yet opened to clients: playerChat, spectatorChat, analyses, puzzles.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
